# No trailing slash on purpose: `node_modules/` only matches directories, so a *symlink*
# named node_modules stays committable (that is how outfitkit#51 got in, twice).
node_modules
dist/
.DS_Store
*.log
.vite/
*.tsbuildinfo
.playwright-mcp/
# npm's lockfile is NOT versioned: the repo's is `pnpm-lock.yaml`, and `publish.yml` installs with
# `--no-package-lock` so release-it never trips over a dirty working dir. Anyone running
# `npm install` here (CI falls back to it) gets one — ignoring it keeps it out of the next commit,
# which is how it slipped into the outfitkit#118 branch.
package-lock.json
